# =============================================================================
# Mob Dr — Git Ignore Configuration
# =============================================================================

# Dependencies & Package Managers
node_modules/
.pnpm-store/
package-lock.json.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Expo & Metro Bundler
.expo/
.expo-shared/
dist/
web-build/
expo-env.d.ts
.metro-health-check*
*.jsbundle

# Environment & Secrets (NEVER COMMIT SENSITIVE KEYS)
.env
.env.*
!.env.example
*.env
*.env.local

# JVM Crash Logs & Java Dumps
hs_err_pid*
replay_pid*
*.hprof
*.log

# Native Android Build Artifacts, Caches & Machine Configuration
/android
.gradle/
android/.gradle/
android/build/
android/app/build/
android/app/.cxx/
android/.kotlin/
android/.idea/
android/local.properties
local.properties
*.iml
*.ipr
*.iws

# Native iOS Build Artifacts & CocoaPods (for future iOS release)
/ios
ios/Pods/
ios/build/
ios/*.xcworkspace/
ios/*.xcodeproj/project.xcworkspace/
ios/*.xcodeproj/xcuserdata/

# Keystores, Signing Keys & Certificates (CRITICAL SECURITY)
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision
*.pem
*.cer
*.crt

# TypeScript Build Info
*.tsbuildinfo

# Editor & IDE Directories
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.patch

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Supabase Local State & Temporary Scratch Files
.supabase/
temp/
tmp/
scratch/
dist_test/
*.tmp
*.bak
